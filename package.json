{
  "name": "lumielle-flowers",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,magenta,cyan \"npm run dev -w @lumielle/api\" \"npm run dev -w @lumielle/web\" \"npm run dev -w @lumielle/admin\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "npm exec prisma db push --workspace=@lumielle/api",
    "db:migrate": "npm run prisma:migrate -w @lumielle/api",
    "db:seed": "npm run prisma:seed -w @lumielle/api",
    "seed:admin": "npm run seed:admin -w @lumielle/api"
  },
  "devDependencies": {"concurrently": "^9.1.2"}
}
